<Project>

  <!--
    Settings shared by the application and its test project.

    LangVersion is pinned to 9.0 by organisation standard (file-scoped
    namespaces, global usings, primary constructors and so on are unavailable
    by design).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
