@*
    The icon set, as one hidden <symbol> sheet rendered once per page.

    WHY INLINE, AND NOT wwwroot/img/sprite.svg
    A cross-document <use href="/img/sprite.svg#i-x"> resolves the symbol in
    the sprite file's own document, where currentColor computes against
    nothing. Every icon would come out black. Inlining keeps the symbols in
    this document, so stroke="currentColor" picks up the colour of whatever
    tile, button or chip the icon sits inside - which is the whole theming
    mechanism. It also removes a request, which matters offline.

    Cost: about 4KB per page, uncacheable. On a LAN, for an internal tool,
    that is the right trade.

    The path data lives here and nowhere else. An icon drawn 400 times in the
    fare grid still costs one copy of its geometry.

    Drawn on a 24x24 grid at stroke-width 1.75 so they read consistently
    between 12px and 24px. Stroke properties sit on the <symbol> so the
    children inherit them.
*@
<svg class="sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">

    @* ── Navigation rail ─────────────────────────────────────────────── *@

    <symbol id="i-grid" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7.5" height="7.5" rx="1.5" />
        <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5" />
        <rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5" />
        <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5" />
    </symbol>

    <symbol id="i-layers" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l9 4.5-9 4.5-9-4.5L12 3z" />
        <path d="M3 12.5l9 4.5 9-4.5" />
        <path d="M3 17l9 4.5 9-4.5" />
    </symbol>

    <symbol id="i-bell" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8.5a6 6 0 10-12 0c0 5-2 6.5-2 6.5h16s-2-1.5-2-6.5z" />
        <path d="M13.7 19a2 2 0 01-3.4 0" />
    </symbol>

    <symbol id="i-ticket" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 8.5V6.5A1.5 1.5 0 014.5 5h15A1.5 1.5 0 0121 6.5v2a2.5 2.5 0 000 5v2a1.5 1.5 0 01-1.5 1.5h-15A1.5 1.5 0 013 15.5v-2a2.5 2.5 0 000-5z" />
        <path d="M14 5v14" stroke-dasharray="2 2.5" />
    </symbol>

    <symbol id="i-swap" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 8h13l-3.5-3.5" />
        <path d="M20 16H7l3.5 3.5" />
    </symbol>

    @* ── Direction. The rail collapse arrow and pagination reuse these,
         flipped with transform where needed. ───────────────────────────── *@

    <symbol id="i-chevron-left" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 5l-7 7 7 7" />
    </symbol>

    <symbol id="i-chevron-right" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 5l7 7-7 7" />
    </symbol>

    <symbol id="i-chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 9l7 7 7-7" />
    </symbol>

    <symbol id="i-arrow-up" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5" />
        <path d="M6 11l6-6 6 6" />
    </symbol>

    <symbol id="i-arrow-down" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14" />
        <path d="M6 13l6 6 6-6" />
    </symbol>

    <symbol id="i-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12h15" />
        <path d="M13 6l6 6-6 6" />
    </symbol>

    @* ── Actions ─────────────────────────────────────────────────────── *@

    <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7" />
        <path d="M20 20l-3.9-3.9" />
    </symbol>

    <symbol id="i-more" viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <circle cx="5" cy="12" r="1.75" />
        <circle cx="12" cy="12" r="1.75" />
        <circle cx="19" cy="12" r="1.75" />
    </symbol>

    <symbol id="i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14" />
        <path d="M5 12h14" />
    </symbol>

    <symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 6l12 12" />
        <path d="M18 6L6 18" />
    </symbol>

    <symbol id="i-rotate-ccw" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3.5 5v5h5" />
        <path d="M4.2 14a8 8 0 103.1-8.6L3.5 8.5" />
    </symbol>

    <symbol id="i-ban" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M6 18L18 6" />
    </symbol>

    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12.5l4.5 4.5L19 7" />
    </symbol>

    <symbol id="i-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="12" height="12" rx="2" />
        <path d="M5 15H4.5A1.5 1.5 0 013 13.5v-9A1.5 1.5 0 014.5 3h9A1.5 1.5 0 0115 4.5V5" />
    </symbol>

    @* ── State ───────────────────────────────────────────────────────── *@

    <symbol id="i-square" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.5" y="3.5" width="17" height="17" rx="4" />
    </symbol>

    <symbol id="i-square-check" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.5" y="3.5" width="17" height="17" rx="4" />
        <path d="M8 12.3l2.7 2.7L16.2 9.5" stroke-width="2.25" />
    </symbol>

    <symbol id="i-info" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 11.5v5" />
        <path d="M12 8h.01" stroke-width="2.25" />
    </symbol>

    <symbol id="i-alert-triangle" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 4.5l8.5 14.5H3.5L12 4.5z" />
        <path d="M12 10v4" />
        <path d="M12 17h.01" stroke-width="2.25" />
    </symbol>

    <symbol id="i-star" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3.5l2.6 5.5 5.9.8-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.8l5.9-.8L12 3.5z" />
    </symbol>

    <symbol id="i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7v5.3l3.3 2" />
    </symbol>

    @* Edit. The nib and the shaft are one stroke so it keeps its shape at
       12px, where a separate tip closes up into a blob. *@
    <symbol id="i-pencil" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20h4l10.5-10.5a2.83 2.83 0 0 0-4-4L4 16v4Z" />
        <path d="M13.5 6.5l4 4" />
    </symbol>

    @* ── Stat card tiles ─────────────────────────────────────────────── *@

    <symbol id="i-currency" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M14.5 9.2A2.8 2.8 0 0012 8c-1.6 0-2.8.9-2.8 2s1.2 1.9 2.8 1.9 2.8.8 2.8 1.9S13.6 16 12 16a2.8 2.8 0 01-2.5-1.2" />
        <path d="M12 6.3v1.6M12 16.1v1.6" />
