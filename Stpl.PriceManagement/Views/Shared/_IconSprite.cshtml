    <symbol id="i-users" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9.5" cy="8.5" r="3.2" />
        <path d="M3.5 19.5a6 6 0 0112 0" />
        <path d="M16.5 6.1a3.2 3.2 0 010 4.8" />
        <path d="M18 14.6a6 6 0 012.5 4.9" />
    </symbol>

    <symbol id="i-share" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="17.5" cy="6" r="2.6" />
        <circle cx="6.5" cy="12" r="2.6" />
        <circle cx="17.5" cy="18" r="2.6" />
        <path d="M8.8 10.8l6.4-3.5" />
        <path d="M8.8 13.2l6.4 3.5" />
    </symbol>

    <symbol id="i-calendar" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
        <path d="M3.5 10h17" />
        <path d="M8 3.5V6M16 3.5V6" />
    </symbol>

    <symbol id="i-send" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.5 3.5l-7 17-3-7-7-3 17-7z" />
        <path d="M10.5 13.5l4-4" />
    </symbol>

    <symbol id="i-plane" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.5 3.2a1.5 1.5 0 013 0V9l7.5 4.4v2.3L13.5 13v4.4l2.5 1.9v1.9L12 20l-4 1.2v-1.9l2.5-1.9V13L3 15.7v-2.3L10.5 9V3.2z" />
    </symbol>

    <symbol id="i-tag" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11.4 3.5H5.5A2 2 0 003.5 5.5v5.9a2 2 0 00.6 1.4l7.6 7.6a2 2 0 002.8 0l5.9-5.9a2 2 0 000-2.8l-7.6-7.6a2 2 0 00-1.4-.6z" />
        <path d="M7.8 7.8h.01" stroke-width="2.5" />
    </symbol>
</svg>
