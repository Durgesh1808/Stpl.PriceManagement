@model PasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData["Crumbs"] = new List<(string, string)>
    {
        ("Change password", null)
    };
}

<div class="card account">
    <div class="card__head">
        <span class="card__title">Change your password</span>
        <span class="card__sub">@Model.DisplayName · @Model.Email</span>
    </div>

    <div class="account__body">
        @if (Model.Changed)
        {
            <div class="banner banner--ok account__banner" role="status">
                <st-icon name="check" class="icon--14" />
                <span>Your password has been changed. Use the new one next time you sign in.</span>
            </div>
        }

        @if (Model.Error != null)
        {
            <div class="banner banner--danger account__banner" role="alert">
                <st-icon name="alert-triangle" class="icon--14" />
                <span>@Model.Error</span>
            </div>
        }

        <form method="post" class="signin__form">
            @* Not typed, not shown, but here: without it a password manager
               saves the new password against no account and offers it nowhere. *@
            <input type="hidden" autocomplete="username" value="@Model.Email" />

            <div class="signin__row">
                <label class="signin__label" for="current">Current password</label>
                <input class="field signin__field" id="current" name="CurrentPassword"
                       type="password" autocomplete="current-password" autofocus required />
            </div>

            <div class="signin__row">
                <label class="signin__label" for="new">New password</label>
                <input class="field signin__field" id="new" name="NewPassword"
                       type="password" autocomplete="new-password" minlength="12" required />
                <p class="account__hint">
                    At least 12 characters. Length is what makes a password hard to
                    guess — a long phrase beats a short one with symbols in it.
                </p>
            </div>

            <div class="signin__row">
                <label class="signin__label" for="confirm">New password again</label>
                <input class="field signin__field" id="confirm" name="ConfirmPassword"
                       type="password" autocomplete="new-password" minlength="12" required />
            </div>

            <button type="submit" class="btn btn--save signin__submit" data-busy="Saving…">
                Change password
            </button>
        </form>
    </div>
</div>
